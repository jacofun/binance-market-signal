{
  "name": "binance-market-signal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node --max-old-space-size=256 server.js",
    "collector": "MARKET_DATA_MODE=websocket node --max-old-space-size=256 server.js",
    "package": "npm run build && python3 scripts/package.py",
    "token": "node scripts/issue-token.mjs"
  },
  "devDependencies": { "@types/node": "24.10.1", "typescript": "5.9.3" }
}
