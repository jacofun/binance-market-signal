# Inject these into FC; this file is never packaged.
# FC ingress verifies signatures. No JWKS environment variable is needed.
SIGNAL_ALLOWED_SYMBOLS=BTCUSDT
PORT=9000
MARKET_DATA_MODE=rest
# Hand-run analyses use M1/M2 by default. Explicit false enables manual LLM comparison.
# USE_DETERMINISTIC_MODELS=false
# USE_M1_TRIGGER=true
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus

# Enable the binance-market-analysis timer with a positive M1 follow-up quota.
# SIGNAL_AUTO_ANALYSIS_DAILY_LIMIT=0
# SIGNAL_AUTO_ORDER_EXECUTE=false

# Shared OSS for automatic analysis, legacy history and orders.
# OSS_BUCKET=
# OSS_REGION=
# OSS_NETWORK=public
# ACCESS_KEY_ID=
# ACCESS_KEY_SECRET=

# Optional order previews and protected market execution. Omit SIGNAL_ORDER_MODE to hide them.
# SIGNAL_ORDER_MODE=demo
# SIGNAL_ORDER_EXECUTE=false
# BINANCE_BASE_URL=https://demo-fapi.binance.com
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# SIGNAL_ORDER_OSS_PREFIX=private/market-signal-orders/v1
# SIGNAL_ORDER_QUANTITY=0.001
# SIGNAL_ORDER_MAX_RISK_USDT=1
